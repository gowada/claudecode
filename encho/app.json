{
  "expo": {
    "name": "No6",
    "slug": "no6",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.no6.app",
      "infoPlist": {
        "NSCameraUsageDescription": "商品写真を撮影するために使用します",
        "NSPhotoLibraryUsageDescription": "写真を選択するために使用します"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.no6.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "No6",
      "shortName": "No6",
      "description": "自然の叡智を、静かに選ぶ。高級はちみつブランドNo6の公式アプリ。",
      "lang": "ja",
      "themeColor": "#0A0A0A",
      "backgroundColor": "#0A0A0A",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "scope": "/"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "no6-honey-app"
      }
    }
  }
}
