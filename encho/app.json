{
  "expo": {
    "name": "縁帳",
    "slug": "encho",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F5F0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.encho.app",
      "infoPlist": {
        "NSCameraUsageDescription": "縁の記録に写真を撮影するために使用します",
        "NSPhotoLibraryUsageDescription": "縁の記録に写真を選択するために使用します",
        "NSLocationWhenInUseUsageDescription": "会った場所を自動で記録するために使用します"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F5F0"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.encho.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "縁の記録に写真を選択するために使用します",
          "cameraPermission": "縁の記録に写真を撮影するために使用します"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "会った場所を自動で記録するために使用します"
        }
      ]
    ]
  }
}
